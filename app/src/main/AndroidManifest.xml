<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice note chat: perekaman hanya berjalan selama tombol mikrofon ditahan. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Pelacakan lokasi kerja (SOP): dijalankan sebagai foreground service dengan
         notifikasi persisten, hanya setelah user menyetujui consent screen di app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Menyalakan ulang pelacakan setelah HP restart / app di-update, tanpa staff harus
         membuka aplikasi lebih dulu. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alarm jaring pengaman yang membangunkan service bila dibunuh OEM. Alarm persis
         dipakai HANYA bila sistem mengizinkan; kalau tidak, kode jatuh ke alarm biasa. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Distribusi mandiri (bukan Play Store), jadi app perlu bisa
         minta izin sendiri untuk pasang APK update yang di-download dari dalam
         aplikasi. Lihat AppUpdateManager. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: izinkan PackageInstaller melakukan self-update tanpa
         konfirmasi user ketika semua syarat platform terpenuhi. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Izin full screen intent untuk meluncurkan kembali UI saat update selesai -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Izin overlay: satu-satunya pengecualian Android 10+ yang membolehkan aplikasi
         membuka dirinya sendiri dari latar belakang setelah update. Lihat AppUpdateRelauncher. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="com.sukashawarma.pos" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".SuperappApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SukaSuperapp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SukaSuperapp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask=false: menggeser app dari Recent Apps tidak boleh ikut mematikan
             pelacakan. Service tetap hidup, dan bila OEM memaksa membunuh prosesnya,
             onTaskRemoved sudah menjadwalkan alarm restart. -->
        <service
            android:name="com.sukashawarma.superapp.data.location.LocationTrackingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name="com.sukashawarma.superapp.data.location.LocationRestartReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Broadcast non-standar yang dipakai ROM HTC/Xiaomi lama untuk fast boot. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Pengingat absen 12:10. Ikut mendengar boot dan pembaruan APK karena
             alarm tidak selamat dari keduanya. -->
        <receiver
            android:name="com.sukashawarma.superapp.feature.absensi.notif.AbsenReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Export CSV rekap: file ditulis ke cache lalu dibagikan lewat sheet sistem. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Penerima push. Tidak berbahaya walau google-services.json belum ada:
             tanpa konfigurasi Firebase, service ini tidak pernah dipanggil. -->
        <service
            android:name=".notif.SuperappMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Balasan yang diketik langsung di bilah notifikasi chat.
             exported="false": hanya sistem notifikasi (lewat PendingIntent milik
             aplikasi ini) yang boleh memicunya, bukan aplikasi lain. -->
        <receiver
            android:name=".notif.BalasChatReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.sukashawarma.superapp.BALAS_CHAT" />
                <action android:name="com.sukashawarma.superapp.TANDAI_DIBACA_CHAT" />
                <action android:name="com.sukashawarma.superapp.TEST_NOTIF_CHAT" />
            </intent-filter>
        </receiver>

        <!-- Balas cepat & tandai dibaca dari notifikasi pesan PRIBADI.
             Tidak diekspor: hanya PendingIntent milik aplikasi ini (dari
             ChatPribadiNotifikasi) yang boleh memicunya. -->
        <receiver
            android:name=".notif.BalasChatPribadiReceiver"
            android:exported="false" />

        <!-- Receiver kontrol alarm / heningkan notifikasi petty cash -->
        <receiver
            android:name=".notif.PettyCashActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sukashawarma.superapp.ACTION_STOP_PETTY_CASH_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Receiver status instalasi update via PackageInstaller -->
        <receiver
            android:name="com.sukashawarma.superapp.core.update.UpdateInstallResultReceiver"
            android:exported="false" />

        <!-- Receiver auto-launch setelah APK baru selesai dipasang (ACTION_MY_PACKAGE_REPLACED).
             exported="false": broadcast sistem tetap sampai, aplikasi lain tidak bisa memicunya. -->
        <receiver
            android:name="com.sukashawarma.superapp.core.update.AppUpdateRelaunchReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
